# Local development values. Copy to .env and replace CHANGE_ME.
# Keep DB_NAME/DB_PORT aligned with the database and port in SPRING_DATASOURCE_URL.
DB_NAME=groceryrun
DB_PORT=5332
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5332/groceryrun
SPRING_DATASOURCE_USERNAME=groceryrun
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
